{{- /* Answers are stored in ~/.config/chezmoi/chezmoi.toml and asked only once. */ -}}
{{- $name := "" -}}{{- $email := "" -}}{{- $signingKey := "" -}}{{- $signingProgram := "" -}}
{{- $vertexProject := "" -}}{{- $vertexLocation := "" -}}{{- $weztermHerdr := false -}}
{{- $agentsRoot := "" -}}{{- $privateSkillsDir := "" -}}
{{- /* Windows gets only the WezTerm config, so it needs no answers. */ -}}
{{- if ne .chezmoi.os "windows" -}}
{{-   $name = promptStringOnce . "name" "Your name (git user.name)" -}}
{{-   $email = promptStringOnce . "email" "Your email (git user.email)" -}}
{{-   $signingKey = promptStringOnce . "gitSigningKey" "SSH signing key: a key file path or a public key (empty for no signing)" "" -}}
{{-   $signingProgram = promptStringOnce . "gitSigningProgram" "SSH signing program, e.g. 1Password's op-ssh-sign (empty for ssh-keygen)" "" -}}
{{-   $vertexProject = promptStringOnce . "vertexProject" "Google Cloud project for Claude on Vertex AI (empty to skip)" "" -}}
{{-   if $vertexProject -}}
{{-     $vertexLocation = promptStringOnce . "vertexLocation" "Vertex AI location (e.g. eu, us, europe-west1)" "eu" -}}
{{-   end -}}
{{-   $weztermHerdr = promptBoolOnce . "weztermStartsHerdr" "Should WezTerm open Herdr in every new window" false -}}
{{-   $agentsRoot = promptStringOnce . "agentsRoot" "Absolute path of the folder with local checkouts of the agent packages and skills (empty to install them from GitHub and npm)" "" -}}
{{-   $privateSkillsDir = promptStringOnce . "privateSkillsDir" "Absolute path of a folder of private skills to copy into ~/.agents/skills (empty for none)" "" -}}
{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
gitSigningKey = {{ $signingKey | quote }}
gitSigningProgram = {{ $signingProgram | quote }}
vertexProject = {{ $vertexProject | quote }}
vertexLocation = {{ $vertexLocation | quote }}
weztermStartsHerdr = {{ $weztermHerdr }}
agentsRoot = {{ $agentsRoot | quote }}
privateSkillsDir = {{ $privateSkillsDir | quote }}
