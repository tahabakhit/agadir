---
name: researcher
description: Public-source researcher for current documentation, implementation status, and technical comparisons.
mode: interactive
auto-exit: true
async: true
session-mode: lineage-only
thinking: max
extensions: {{ template "role-extensions" (dict "base" (list (includeTemplate "pi-own-source" (dict "source" "npm:@tahabakhit/pi-research-kit" "data" .))) "data" .) }}
skills: none
tools: web_search,web_fetch
