---
name: worker
description: Write-capable implementation worker for scoped repository changes and focused verification.
mode: interactive
auto-exit: true
async: true
session-mode: lineage-only
thinking: high
extensions: {{ template "role-extensions" (dict "base" (list) "data" .) }}
skills: none
tools: read,bash,edit,write,grep,find,ls
spawning: false
