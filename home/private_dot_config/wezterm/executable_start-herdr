#!/bin/sh
set -eu

# GUI apps on macOS often receive a smaller PATH than an interactive shell.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

if command -v herdr >/dev/null 2>&1; then
  exec "$(command -v herdr)" "$@"
fi

printf '%s\n' \
  'Herdr was not found.' \
  'Install it with Homebrew (`brew install herdr`) or see:' \
  'https://herdr.dev/docs/install/' \
  'Falling back to a login shell.' >&2

exec "${SHELL:-/bin/zsh}" -l
