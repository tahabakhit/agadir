{{- /* The herdr-projects blocks must match what `herdr-projects configure` writes, byte for byte, or the two keep rewriting this file. They appear once the plugin is installed. */ -}}
{{- $hp := "" -}}
{{- range glob (joinPath .chezmoi.homeDir ".config/herdr/plugins/github/herdr-projects-*/target/release/herdr-projects") }}{{ $hp = . }}{{ end -}}
onboarding = false

# Herdr owns multiplexing inside the single outer WezTerm surface.
[theme]
name = "catppuccin"
auto_switch = false

[ui]
sidebar_collapsed_mode = "compact"
agent_panel_sort = "priority"
window_title = "Herdr — {workspace} · {tab}"
mouse_scroll_lines = 5
status_indicators = "dots"
{{- if $hp }}
tab_bar_right = [{ type = "command", command = "{{ $hp }} --root {{ joinPath .chezmoi.homeDir ".herdr-projects" }} needs-you --line", interval_seconds = 15, timeout_seconds = 5 }]
{{- end }}

# WezTerm turns Herdr's OSC 9 notifications into macOS notifications.
[ui.toast]
delivery = "terminal"
delay_seconds = 1

[terminal]
# On macOS this starts login shells, preserving Homebrew and user PATH setup.
shell_mode = "auto"
new_cwd = "follow"
kitty_graphics = true

[advanced]
scrollback_limit_bytes = 50000000

[keys]
# WezTerm intentionally has no Ctrl leader; this prefix belongs to Herdr.
prefix = "ctrl+b"
copy_mode = "prefix+["
edit_scrollback = "prefix+e"

# Available when the optional ray.plugin-manager plugin is installed.
[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "ray.plugin-manager.open"
description = "open plugin manager"

[[keys.command]]
key = "prefix+t"
type = "plugin_action"
command = "herdr-tsk.open-board"

[[keys.command]]
key = "prefix+a"
type = "plugin_action"
command = "herdr-tsk.quick-capture"
{{- if $hp }}

[[keys.command]]
key = "prefix+y"
type = "plugin_action"
command = "herdr-projects.open-popup"
description = "Projects"
{{- end }}

[ui.sound]
enabled = false
{{- if $hp }}

[ui.sidebar.agents]
rows = [["state_icon", "machine", "workspace", "tab"], ["agent"], [{ token = "$hp_state", rules = [{ starts_with = "needs you", fg = "#f38ba8", bold = true }, { starts_with = "review", fg = "#f9e2af" }] }], [{ token = "$hp_activity", dim = true }]]

[ui.sidebar.spaces]
rows = [["state_icon", "workspace"], ["branch", "git_status"], [{ token = "$hp" }]]
{{- end }}
