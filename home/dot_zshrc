# Interactive zsh.
[[ -o interactive ]] || return

# History: large, shared between sessions, no duplicates, space-prefixed lines skipped.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Completion, with the dump rebuilt at most once a day.
autoload -Uz compinit
() {
	setopt local_options extended_glob
	if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
}
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
# fzf 0.48 and later print their own zsh integration; it needs the line editor,
# which shells without a terminal (agents running `zsh -ic`) don't have.
if [[ -o zle ]] && command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1; then
	source <(fzf --zsh)
fi
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
if command -v starship >/dev/null 2>&1 && [[ $TERM != dumb ]]; then
	eval "$(starship init zsh)"
fi

[ -r "$HOME/.config/shell/aliases.zsh" ] && source "$HOME/.config/shell/aliases.zsh"
[ -r "$HOME/.config/shell/local.zsh" ] && source "$HOME/.config/shell/local.zsh"
