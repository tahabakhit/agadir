<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<!-- Replace this placeholder with a unique reverse-DNS launch agent label. -->
	<string>REPLACE_WITH_YOUR_LAUNCH_AGENT_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/launchctl</string>
		<string>setenv</string>
		<string>BASH_ENV</string>
		<!-- Replace this placeholder with the absolute path to the user's bashrc. -->
		<string>REPLACE_WITH_YOUR_BASHRC_PATH</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
</dict>
</plist>
