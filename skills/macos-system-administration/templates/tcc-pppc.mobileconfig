<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDescription</key>
			<string>Pre-grants TCC permissions for approved developer tools on a headless Mac.</string>
			<key>PayloadDisplayName</key>
			<string>PPPC for Approved Developer Tools</string>
			<key>PayloadIdentifier</key>
			<string>YOUR.REVERSE.DOMAIN.TCC.UUID</string>
			<key>PayloadType</key>
			<string>com.apple.TCC.configuration-profile-policy</string>
			<key>PayloadUUID</key>
			<string>UUID-HERE</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>Services</key>
			<dict>

				<!-- Full Disk Access: inherits to all subprocesses -->
				<key>SystemPolicyAllFiles</key>
				<array>

					<!-- Terminal.app: stable Apple-signed, use bundleID -->
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.Terminal" and anchor apple</string>
						<key>Comment</key>
						<string>All CLI tools run from Terminal inherit FDA</string>
						<key>Identifier</key>
						<string>com.apple.Terminal</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
					</dict>

					<!-- Approved agent app: ad-hoc signed, use path + identifier -->
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.example.agent"</string>
						<key>Comment</key>
						<string>Approved agent app and subprocesses. Re-install profile after app updates.</string>
						<key>Identifier</key>
						<string>FULL_PATH_TO_AGENT.app</string>
						<key>IdentifierType</key>
						<string>path</string>
					</dict>

					<!-- Python: ad-hoc signed, use path + cdhash -->
					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>cdhash H"REPLACE_WITH_CDHASH"</string>
						<key>Comment</key>
						<string>Python binary. Update cdhash after brew upgrade python.</string>
						<key>Identifier</key>
						<string>FULL_PATH_TO_PYTHON_BINARY</string>
						<key>IdentifierType</key>
						<string>path</string>
					</dict>

				</array>

				<!-- Accessibility: approved agent GUI automation -->
				<key>Accessibility</key>
				<array>

					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.example.agent"</string>
						<key>Comment</key>
						<string>Approved agent GUI automation: clicking, typing, screenshots</string>
						<key>Identifier</key>
						<string>FULL_PATH_TO_AGENT.app</string>
						<key>IdentifierType</key>
						<string>path</string>
					</dict>

				</array>

				<!-- Developer Tools: prevent Gatekeeper prompts -->
				<key>DeveloperTool</key>
				<array>

					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.apple.Terminal" and anchor apple</string>
						<key>Comment</key>
						<string>Prevents Gatekeeper prompts for CLI tools</string>
						<key>Identifier</key>
						<string>com.apple.Terminal</string>
						<key>IdentifierType</key>
						<string>bundleID</string>
					</dict>

					<dict>
						<key>Allowed</key>
						<true/>
						<key>CodeRequirement</key>
						<string>identifier "com.example.agent"</string>
						<key>Comment</key>
						<string>Prevents Gatekeeper prompts for approved agent-spawned tools</string>
						<key>Identifier</key>
						<string>FULL_PATH_TO_AGENT.app</string>
						<key>IdentifierType</key>
						<string>path</string>
					</dict>

				</array>

			</dict>
		</dict>
	</array>

	<key>PayloadDescription</key>
	<string>Pre-grants TCC permissions for approved developer tools.</string>
	<key>PayloadDisplayName</key>
	<string>Developer Tools TCC</string>
	<key>PayloadIdentifier</key>
	<string>YOUR.REVERSE.DOMAIN.TCC</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>UUID-HERE</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
